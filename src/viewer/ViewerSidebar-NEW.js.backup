/**
 * ViewerSidebar-NEW.js
 * 
 * CUSTOM IMPLEMENTATION - Created for viewer-specific sidebar integration
 * 
 * Modular sidebar system for individual viewers with:
 * - Tailwind CSS styling
 * - Headless UI components
 * - Hamburger menu with collapsible sections
 * - Quick action icons (Top View, Lock View, Zoom Extents)
 * - Viewport-aware positioning to prevent spillover
 * - Memory-efficient modular components
 * 
 * Each viewer gets its own independent sidebar instance.
 */

import { EventDispatcher } from "../EventDispatcher.js";

export class ViewerSidebar extends EventDispatcher {
    
    constructor(viewer, viewerId, viewerManager) {
        super();
        
        this.viewer = viewer;
        this.viewerId = viewerId;
        this.viewerManager = viewerManager;
        
        // State management
        this.isOpen = false;
        this.isInitialized = false;
        
        // UI configuration
        this.config = {
            position: 'left', // left, right
            width: '280px',
            maxHeight: '80vh',
            zIndex: 1000,
            animations: true,
            theme: 'dark' // dark, light
        };
        
        // Sidebar sections
        this.sections = new Map();
        this.activeSections = new Set(['appearance', 'tools', 'scene']);
        
        // DOM references
        this.containerElement = null;
        this.sidebarElement = null;
        this.hamburgerButton = null;
        this.quickActionButtons = null;
        this.contentContainer = null;
        
        // Quick actions state
        this.quickActions = {
            topView: false,
            lockView: false,
            lastViewState: null
        };
        
        this.initialize();
    }
    
    /**
     * Initialize the sidebar system
     */
    initialize() {
        if (this.isInitialized || !this.viewer.renderArea) {
            return;
        }
        
        // Create sidebar container
        this.createSidebarContainer();
        
        // Create hamburger menu and quick actions
        this.createMenuButtons();
        
        // Create sidebar content
        this.createSidebarContent();
        
        // Initialize sidebar sections
        this.initializeSections();
        
        // Setup event handlers
        this.setupEventHandlers();
        
        // Inject Tailwind CSS if not present
        this.ensureTailwindCSS();
        
        this.isInitialized = true;
        
        console.log(`ViewerSidebar initialized for viewer '${this.viewerId}'`);
        
        this.dispatchEvent({
            type: 'sidebar_initialized',
            viewerId: this.viewerId,
            sidebar: this
        });
    }
    
    /**
     * Create the main sidebar container
     */
    createSidebarContainer() {
        const viewerContainer = this.viewer.renderArea;
        if (!viewerContainer) {
            throw new Error(`No render area found for viewer '${this.viewerId}'`);
        }
        
        // Ensure viewer container has relative positioning and proper overflow handling
        const containerStyle = window.getComputedStyle(viewerContainer);
        if (containerStyle.position === 'static') {
            viewerContainer.style.position = 'relative';
        }
        
        // Ensure overflow is visible for sidebars but clipped properly to viewport boundaries
        if (containerStyle.overflow === 'hidden') {
            viewerContainer.style.overflow = 'visible';
        }
        
        // Add viewport constraint class to prevent spillover
        viewerContainer.classList.add('potree-viewport-container');
        
        this.containerElement = viewerContainer;
    }
    
    /**
     * Create hamburger menu button and quick action icons
     */
    createMenuButtons() {
        // Create buttons container with animation support
        const buttonsContainer = document.createElement('div');
        buttonsContainer.className = `
            absolute top-4 left-4 z-50 flex items-center gap-2 
            transition-transform duration-300 ease-in-out
        `;
        buttonsContainer.dataset.viewerSidebar = this.viewerId;
        buttonsContainer.id = `sidebar-buttons-${this.viewerId}`;
        
        // Hamburger menu button
        this.hamburgerButton = document.createElement('button');
        this.hamburgerButton.className = `
            bg-gray-800 hover:bg-gray-700 text-white p-2 rounded-lg
            shadow-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500
        `;
        this.hamburgerButton.innerHTML = `
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        `;
        this.hamburgerButton.title = 'Open Sidebar';
        
        // Quick action buttons container
        const quickActionsContainer = document.createElement('div');
        quickActionsContainer.className = 'flex items-center gap-1';
        
        // Top View button
        const topViewButton = document.createElement('button');
        topViewButton.className = `
            bg-gray-600 hover:bg-gray-500 text-white p-1.5 rounded
            opacity-70 hover:opacity-100 transition-all duration-200
            focus:outline-none focus:ring-1 focus:ring-blue-400
        `;
        topViewButton.innerHTML = `
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
        `;
        topViewButton.title = 'Top View';
        
        // Lock View button
        const lockViewButton = document.createElement('button');
        lockViewButton.className = `
            bg-gray-600 hover:bg-gray-500 text-white p-1.5 rounded
            opacity-70 hover:opacity-100 transition-all duration-200
            focus:outline-none focus:ring-1 focus:ring-blue-400
        `;
        lockViewButton.innerHTML = `
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
        `;
        lockViewButton.title = 'Lock View';
        
        // Zoom Extents button
        const zoomExtentsButton = document.createElement('button');
        zoomExtentsButton.className = `
            bg-gray-600 hover:bg-gray-500 text-white p-1.5 rounded
            opacity-70 hover:opacity-100 transition-all duration-200
            focus:outline-none focus:ring-1 focus:ring-blue-400
        `;
        zoomExtentsButton.innerHTML = `
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
            </svg>
        `;
        zoomExtentsButton.title = 'Zoom to Extents';
        
        // Store references
        this.quickActionButtons = {
            topView: topViewButton,
            lockView: lockViewButton,
            zoomExtents: zoomExtentsButton
        };
        
        // Assemble buttons
        quickActionsContainer.appendChild(topViewButton);
        quickActionsContainer.appendChild(lockViewButton);
        quickActionsContainer.appendChild(zoomExtentsButton);
        
        buttonsContainer.appendChild(this.hamburgerButton);
        buttonsContainer.appendChild(quickActionsContainer);
        
        // Store reference for animation
        this.buttonsContainer = buttonsContainer;
        
        this.containerElement.appendChild(buttonsContainer);
    }
    
    /**
     * Create the main sidebar content
     */
    createSidebarContent() {
        this.sidebarElement = document.createElement('div');
        this.sidebarElement.className = `
            absolute top-0 left-0 h-full bg-gray-900 text-white sidebar-element
            transform -translate-x-full transition-transform duration-300 ease-in-out
            shadow-2xl overflow-hidden z-40
        `;
        this.sidebarElement.style.width = this.config.width;
        this.sidebarElement.dataset.viewerSidebar = this.viewerId;
        
        // Sidebar header (simplified without redundant close button)
        const header = document.createElement('div');
        header.className = `
            bg-gray-800 px-4 py-3 border-b border-gray-700
            flex items-center
        `;
        
        const title = document.createElement('h2');
        title.className = 'text-lg font-semibold text-white';
        title.textContent = `Viewer: ${this.viewerId}`;
        
        header.appendChild(title);
        
        // Sidebar content container
        this.contentContainer = document.createElement('div');
        this.contentContainer.className = `
            flex-1 overflow-y-auto overflow-x-hidden
            scrollbar-thin scrollbar-thumb-gray-600 scrollbar-track-gray-800
        `;
        this.contentContainer.style.maxHeight = this.config.maxHeight;
        
        // Assemble sidebar
        this.sidebarElement.appendChild(header);
        this.sidebarElement.appendChild(this.contentContainer);
        
        this.containerElement.appendChild(this.sidebarElement);
    }
    
    /**
     * Initialize sidebar sections
     */
    initializeSections() {
        // Create section definitions
        const sectionConfigs = [
            { id: 'appearance', title: 'Appearance', icon: 'eye', order: 1 },
            { id: 'measurement', title: 'Measurement', icon: 'ruler', order: 2 },
            { id: 'clipping', title: 'Clipping', icon: 'scissors', order: 3 },
            { id: 'navigation', title: 'Navigation', icon: 'cursor-click', order: 4 },
            { id: 'scene', title: 'Scene', icon: 'cube', order: 5 },
            { id: 'filters', title: 'Filters', icon: 'filter', order: 6 },
            { id: 'about', title: 'About', icon: 'information-circle', order: 7 }
        ];
        
        sectionConfigs.forEach(config => {
            const section = this.createSection(config);
            this.sections.set(config.id, section);
            
            // Add section to the sidebar content container
            this.contentContainer.appendChild(section.element);
        });
        
        console.log(`Created ${this.sections.size} sidebar sections for viewer '${this.viewerId}'`);
    }
    
    /**
     * Create a collapsible section
     */
    createSection(config) {
        const section = document.createElement('div');
        section.className = 'border-b border-gray-700 last:border-b-0';
        section.dataset.sectionId = config.id;
        
        // Section header
        const header = document.createElement('button');
        header.className = `
            w-full px-4 py-3 text-left flex items-center justify-between
            hover:bg-gray-800 transition-colors duration-200
            focus:outline-none focus:bg-gray-800
        `;
        
        const headerContent = document.createElement('div');
        headerContent.className = 'flex items-center gap-3';
        
        const icon = document.createElement('div');
        icon.innerHTML = this.getSectionIcon(config.icon);
        icon.className = 'text-gray-400';
        
        const title = document.createElement('span');
        title.className = 'font-medium text-white';
        title.textContent = config.title;
        
        const chevron = document.createElement('div');
        chevron.className = 'text-gray-400 transform transition-transform duration-200';
        chevron.innerHTML = `
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
        `;
        
        headerContent.appendChild(icon);
        headerContent.appendChild(title);
        header.appendChild(headerContent);
        header.appendChild(chevron);
        
        // Section content
        const content = document.createElement('div');
        content.className = `
            max-h-0 overflow-hidden transition-all duration-300 ease-in-out
            bg-gray-850
        `;
        
        const contentInner = document.createElement('div');
        contentInner.className = 'p-4 space-y-3';
        
        // Populate section content based on type
        this.populateSectionContent(contentInner, config.id);
        
        content.appendChild(contentInner);
        
        section.appendChild(header);
        section.appendChild(content);
        
        // Store references
        const sectionObj = {
            id: config.id,
            element: section,
            header: header,
            content: content,
            chevron: chevron,
            isOpen: this.activeSections.has(config.id),
            order: config.order
        };
        
        // Set initial state
        if (sectionObj.isOpen) {
            this.expandSection(sectionObj);
        }
        
        return sectionObj;
    }
    
    /**
     * Get SVG icon for section
     */
    getSectionIcon(iconName) {
        const icons = {
            eye: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>`,
            photograph: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>`,
            ruler: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/>
            </svg>`,
            scissors: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1M9 16v-6a2 2 0 012-2h2a2 2 0 012 2v6M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>`,
            'cursor-click': `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/>
            </svg>`,
            cube: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>`,
            filter: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.207A1 1 0 013 6.5V4z"/>
            </svg>`,
            'information-circle': `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>`
        };
        
        return icons[iconName] || icons['information-circle'];
    }
    
    /**
     * Populate section content based on section type
     */
    populateSectionContent(container, sectionId) {
        switch (sectionId) {
            case 'appearance':
                this.createAppearanceSection(container);
                break;
            case 'measurement':
                this.createMeasurementSection(container);
                break;
            case 'clipping':
                this.createClippingSection(container);
                break;
            case 'navigation':
                this.createNavigationSection(container);
                break;
            case 'scene':
                this.createSceneSection(container);
                break;
            case 'filters':
                this.createFiltersSection(container);
                break;
            case 'about':
                this.createAboutSection(container);
                break;
            default:
                container.innerHTML = `<p class="text-gray-400">Section content for ${sectionId}</p>`;
        }
    }
    
    /**
     * Create Appearance section content
     */
    createAppearanceSection(container) {
        container.innerHTML = `
            <ul class="pv-menu-list space-y-2 text-sm">
                <li class="flex items-center justify-between">
                    <span class="text-gray-300">Point Budget:</span>
                    <span id="lblPointBudget-${this.viewerId}" class="text-gray-400">1,000,000</span>
                </li>
                <li>
                    <input type="range" id="sldPointBudget-${this.viewerId}" 
                           min="100000" max="10000000" value="1000000" step="1000"
                           class="w-full h-2 bg-gray-700 rounded-lg appearance-none slider-thumb">
                </li>
                
                <li class="flex items-center justify-between pt-2">
                    <span class="text-gray-300">Field of View:</span>
                    <span id="lblFOV-${this.viewerId}" class="text-gray-400">60°</span>
                </li>
                <li>
                    <input type="range" id="sldFOV-${this.viewerId}"
                           min="20" max="100" value="60" step="1"
                           class="w-full h-2 bg-gray-700 rounded-lg appearance-none slider-thumb">
                </li>

                <div class="border-t border-gray-700 my-3"></div>
                <li class="text-gray-300 font-medium">Eye-Dome-Lighting</li>
                
                <li>
                    <label class="flex items-center space-x-2">
                        <input type="checkbox" id="chkEDLEnabled-${this.viewerId}" class="w-4 h-4 text-blue-600 rounded">
                        <span class="text-sm text-gray-300">Enable EDL</span>
                    </label>
                </li>

            </ul>
        `;
        
        // Connect controls to viewer functionality (like original sidebar.js)
        this.connectAppearanceControls();
    }
    
    /**
     * Connect appearance controls to viewer functionality (based on original sidebar.js)
     */
    connectAppearanceControls() {
        if (!this.viewer) {
            console.warn(`No viewer available for sidebar ${this.viewerId}`);
            return;
        }
        
        const viewerId = this.viewerId;
        
        // Debug: Check if viewer methods exist
        console.log('Viewer object for', this.viewerId, ':', this.viewer);
        console.log('Viewer constructor:', this.viewer.constructor.name);
        console.log('Viewer methods available for', this.viewerId, ':', {
            getPointBudget: typeof this.viewer.getPointBudget,
            setPointBudget: typeof this.viewer.setPointBudget,
            getFOV: typeof this.viewer.getFOV,
            setFOV: typeof this.viewer.setFOV,
            getEDLEnabled: typeof this.viewer.getEDLEnabled,
            setEDLEnabled: typeof this.viewer.setEDLEnabled,
        });
        
        // Check current values
        if (this.viewer.getPointBudget) {
            console.log('Current point budget:', this.viewer.getPointBudget());
        }
        if (this.viewer.getFOV) {
            console.log('Current FOV:', this.viewer.getFOV());
        }
        
        // Point Budget Slider
        const sldPointBudget = document.getElementById(`sldPointBudget-${viewerId}`);
        const lblPointBudget = document.getElementById(`lblPointBudget-${viewerId}`);
        
        if (sldPointBudget && lblPointBudget) {
            // Set initial value
            const currentPointBudget = this.viewer.getPointBudget ? this.viewer.getPointBudget() : 1000000;
            sldPointBudget.value = currentPointBudget;
            lblPointBudget.textContent = this.addCommas(currentPointBudget);
            
            // Handle slider changes
            sldPointBudget.addEventListener('input', (e) => {
                const value = parseInt(e.target.value);
                console.log(`Point Budget slider changed to: ${value} for viewer ${viewerId}`);
                
                if (this.viewer.setPointBudget) {
                    console.log('Calling viewer.setPointBudget with:', value);
                    
                    // Get current value before change
                    const beforeValue = this.viewer.getPointBudget ? this.viewer.getPointBudget() : 'unknown';
                    console.log('Point budget before change:', beforeValue);
                    
                    this.viewer.setPointBudget(value);
                    
                    // Get value after change to verify it worked
                    const afterValue = this.viewer.getPointBudget ? this.viewer.getPointBudget() : 'unknown';
                    console.log('Point budget after change:', afterValue);
                    
                    // Check if we have point clouds that should be affected
                    if (this.viewer.scene && this.viewer.scene.pointclouds) {
                        console.log('Point clouds that should be affected:', this.viewer.scene.pointclouds.length);
                    }
                } else {
                    console.error('viewer.setPointBudget not available');
                }
                lblPointBudget.textContent = this.addCommas(value);
            });
        }
        
        // Field of View Slider
        const sldFOV = document.getElementById(`sldFOV-${viewerId}`);
        const lblFOV = document.getElementById(`lblFOV-${viewerId}`);
        
        if (sldFOV && lblFOV) {
            // Set initial value
            const currentFOV = this.viewer.getFOV ? this.viewer.getFOV() : 60;
            sldFOV.value = currentFOV;
            lblFOV.textContent = Math.round(currentFOV) + '°';
            
            // Handle slider changes
            sldFOV.addEventListener('input', (e) => {
                const value = parseInt(e.target.value);
                console.log(`FOV slider changed to: ${value} for viewer ${viewerId}`);
                
                if (this.viewer.setFOV) {
                    console.log('Calling viewer.setFOV with:', value);
                    
                    const beforeValue = this.viewer.getFOV ? this.viewer.getFOV() : 'unknown';
                    console.log('FOV before change:', beforeValue);
                    
                    this.viewer.setFOV(value);
                    
                    const afterValue = this.viewer.getFOV ? this.viewer.getFOV() : 'unknown';
                    console.log('FOV after change:', afterValue);
                    
                    // Check camera FOV
                    if (this.viewer.scene && this.viewer.scene.getActiveCamera) {
                        const camera = this.viewer.scene.getActiveCamera();
                        if (camera && camera.fov !== undefined) {
                            console.log('Camera FOV after change:', camera.fov);
                        }
                    }
                } else {
                    console.error('viewer.setFOV not available');
                }
                lblFOV.textContent = value + '°';
            });
        }
        
        // EDL Checkbox
        const chkEDLEnabled = document.getElementById(`chkEDLEnabled-${viewerId}`);
        
        if (chkEDLEnabled) {
            // Set initial value
            const currentEDL = this.viewer.getEDLEnabled ? this.viewer.getEDLEnabled() : false;
            chkEDLEnabled.checked = currentEDL;
            
            // Handle checkbox changes
            chkEDLEnabled.addEventListener('change', (e) => {
                console.log(`EDL checkbox changed to: ${e.target.checked} for viewer ${viewerId}`);
                
                if (this.viewer.setEDLEnabled) {
                    console.log('Calling viewer.setEDLEnabled with:', e.target.checked);
                    this.viewer.setEDLEnabled(e.target.checked);
                } else {
                    console.error('viewer.setEDLEnabled not available');
                }
            });
        }
        
        // Set up event listeners to update UI when viewer changes (like original)
        this.setupViewerEventListeners();
    }
    
    /**
     * Setup event listeners to update UI when viewer properties change
     */
    setupViewerEventListeners() {
        if (!this.viewer || !this.viewer.addEventListener) {
            return;
        }
        
        const viewerId = this.viewerId;
        
        // Listen for point budget changes
        this.viewer.addEventListener('point_budget_changed', (event) => {
            const lblPointBudget = document.getElementById(`lblPointBudget-${viewerId}`);
            const sldPointBudget = document.getElementById(`sldPointBudget-${viewerId}`);
            
            if (lblPointBudget) {
                lblPointBudget.textContent = this.addCommas(this.viewer.getPointBudget());
            }
            if (sldPointBudget) {
                sldPointBudget.value = this.viewer.getPointBudget();
            }
        });
        
        // Listen for FOV changes
        this.viewer.addEventListener('fov_changed', (event) => {
            const lblFOV = document.getElementById(`lblFOV-${viewerId}`);
            const sldFOV = document.getElementById(`sldFOV-${viewerId}`);
            
            if (lblFOV) {
                lblFOV.textContent = Math.round(this.viewer.getFOV()) + '°';
            }
            if (sldFOV) {
                sldFOV.value = this.viewer.getFOV();
            }
        });
        
        // Listen for EDL changes
        this.viewer.addEventListener('use_edl_changed', (event) => {
            const chkEDLEnabled = document.getElementById(`chkEDLEnabled-${viewerId}`);
            if (chkEDLEnabled) {
                chkEDLEnabled.checked = this.viewer.getEDLEnabled();
            }
        });
    }
    
    /**
     * Utility function to add commas to numbers (from Utils.js)
     */
    addCommas(num) {
        return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }
    
    /**
     * Create Measurement section content
     */
    createMeasurementSection(container) {
        container.innerHTML = `
            <div class="space-y-3">
                <button id="distanceTool-${this.viewerId}" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-lg transition-colors">
                    Distance Tool
                </button>
                <button id="areaTool-${this.viewerId}" class="w-full bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition-colors">
                    Area Tool
                </button>
                <button id="volumeTool-${this.viewerId}" class="w-full bg-purple-600 hover:bg-purple-700 text-white py-2 px-4 rounded-lg transition-colors">
                    Volume Tool
                </button>
                <button id="clearMeasurements-${this.viewerId}" class="w-full bg-red-600 hover:bg-red-700 text-white py-2 px-4 rounded-lg transition-colors">
                    Clear All
                </button>
            </div>
        `;
        
        // Connect measurement tools to viewer functionality
        this.connectMeasurementControls();
    }
    
    /**
     * Connect measurement buttons to viewer measurement tools
     */
    connectMeasurementControls() {
        const viewerId = this.viewerId;
        
        // Distance tool
        const distanceBtn = document.getElementById(`distanceTool-${viewerId}`);
        if (distanceBtn) {
            distanceBtn.addEventListener('click', () => {
                if (this.viewer && this.viewer.measuringTool && this.viewer.measuringTool.startInsertion) {
                    console.log('Starting distance measurement for viewer:', viewerId);
                    try {
                        const measurement = this.viewer.measuringTool.startInsertion({
                            showDistances: true,
                            showArea: false,
                            closed: false,
                            name: 'Distance'
                        });
                        console.log('Distance measurement created:', measurement);
                    } catch (error) {
                        console.error('Error creating distance measurement:', error);
                    }
                }
            });
        }
        
        // Area tool
        const areaBtn = document.getElementById(`areaTool-${viewerId}`);
        if (areaBtn) {
            areaBtn.addEventListener('click', () => {
                if (this.viewer && this.viewer.measuringTool && this.viewer.measuringTool.startInsertion) {
                    console.log('Starting area measurement for viewer:', viewerId);
                    try {
                        const measurement = this.viewer.measuringTool.startInsertion({
                            showDistances: true,
                            showArea: true,
                            closed: true,
                            name: 'Area'
                        });
                        console.log('Area measurement created:', measurement);
                    } catch (error) {
                        console.error('Error creating area measurement:', error);
                    }
                }
            });
        }
        
        // Volume tool
        const volumeBtn = document.getElementById(`volumeTool-${viewerId}`);
        if (volumeBtn) {
            volumeBtn.addEventListener('click', () => {
                if (this.viewer && this.viewer.volumeTool && this.viewer.volumeTool.startInsertion) {
                    console.log('Starting volume measurement for viewer:', viewerId);
                    try {
                        const volume = this.viewer.volumeTool.startInsertion();
                        console.log('Volume measurement created:', volume);
                    } catch (error) {
                        console.error('Error creating volume measurement:', error);
                    }
                }
            });
        }
        
        // Clear all measurements
        const clearBtn = document.getElementById(`clearMeasurements-${viewerId}`);
        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                if (this.viewer && this.viewer.scene && this.viewer.scene.removeAllMeasurements) {
                    console.log('Clearing all measurements for viewer:', viewerId);
                    try {
                        this.viewer.scene.removeAllMeasurements();
                        console.log('All measurements cleared');
                    } catch (error) {
                        console.error('Error clearing measurements:', error);
                    }
                }
            });
        }
    }
    
    /**
     * Create Clipping section content
     */
    createClippingSection(container) {
        container.innerHTML = `
            <div class="space-y-3">
                <button class="w-full bg-orange-600 hover:bg-orange-700 text-white py-2 px-4 rounded-lg transition-colors">
                    Box Clipping
                </button>
                <button class="w-full bg-yellow-600 hover:bg-yellow-700 text-white py-2 px-4 rounded-lg transition-colors">
