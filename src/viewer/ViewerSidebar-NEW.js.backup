    /**
     * Setup event handlers
     */
    setupEventHandlers() {
        // Hamburger button click
        this.hamburgerButton.addEventListener('click', (e) => {
            e.stopPropagation();
            this.toggle();
        });
        
        // Close button click
        // Close button removed - only hamburger button controls sidebar now
        
        // Section toggle handlers
        this.sections.forEach((section) => {
            section.header.addEventListener('click', (e) => {
                e.stopPropagation();
                this.toggleSection(section.id);
            });
        });
        
        // Quick action handlers
        this.quickActionButtons.topView.addEventListener('click', (e) => {
            e.stopPropagation();
            this.handleTopView();
        });
        
        this.quickActionButtons.lockView.addEventListener('click', (e) => {
            e.stopPropagation();
            this.handleLockView();
        });
        
        this.quickActionButtons.zoomExtents.addEventListener('click', (e) => {
            e.stopPropagation();
            this.handleZoomExtents();
        });
        
        // Click outside to close
        document.addEventListener('click', (e) => {
            if (this.isOpen && !this.sidebarElement.contains(e.target) && !this.hamburgerButton.contains(e.target)) {
                this.close();
            }
        });
        
        // Prevent sidebar clicks from closing
        this.sidebarElement.addEventListener('click', (e) => {
            e.stopPropagation();
        });
    }
    
    /**
     * Ensure scoped CSS is loaded (without global Tailwind that affects the whole page)
     */
    ensureTailwindCSS() {
        // Check multiple ways to prevent duplicate CSS injection
        if (document.getElementById('viewer-sidebar-css') || 
            document.querySelector('style[data-viewer-sidebar-styles]') ||
            window.viewerSidebarStylesLoaded) {
            return;
        }
        
        // Mark as loaded globally to prevent duplicates
        window.viewerSidebarStylesLoaded = true;
        
        // Add only scoped styles instead of full Tailwind CSS to prevent global conflicts
        const scopedStyles = document.createElement('style');
        scopedStyles.id = 'viewer-sidebar-css';
        scopedStyles.setAttribute('data-viewer-sidebar-styles', 'true');
        scopedStyles.textContent = `
            /* Scoped Sidebar Styles - Only affects elements with data-viewer-sidebar attribute */
            [data-viewer-sidebar] {
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            }
            
            /* Utility classes scoped to sidebar */
            [data-viewer-sidebar] .absolute { position: absolute !important; }
            [data-viewer-sidebar] .relative { position: relative !important; }
            [data-viewer-sidebar] .top-0 { top: 0 !important; }
            [data-viewer-sidebar] .left-0 { left: 0 !important; }
            [data-viewer-sidebar] .h-full { height: 100% !important; }
            [data-viewer-sidebar] .w-full { width: 100% !important; }
            [data-viewer-sidebar] .w-5 { width: 1.25rem !important; }
            [data-viewer-sidebar] .w-4 { width: 1rem !important; }
            [data-viewer-sidebar] .h-5 { height: 1.25rem !important; }
            [data-viewer-sidebar] .h-4 { height: 1rem !important; }
            [data-viewer-sidebar] .flex { display: flex !important; }
            [data-viewer-sidebar] .flex-1 { flex: 1 1 0% !important; }
            [data-viewer-sidebar] .items-center { align-items: center !important; }
            [data-viewer-sidebar] .justify-between { justify-content: space-between !important; }
            [data-viewer-sidebar] .space-x-3 > * + * { margin-left: 0.75rem !important; }
            [data-viewer-sidebar] .space-y-3 > * + * { margin-top: 0.75rem !important; }
            [data-viewer-sidebar] .space-y-4 > * + * { margin-top: 1rem !important; }
            [data-viewer-sidebar] .px-4 { padding-left: 1rem !important; padding-right: 1rem !important; }
            [data-viewer-sidebar] .py-2 { padding-top: 0.5rem !important; padding-bottom: 0.5rem !important; }
            [data-viewer-sidebar] .py-3 { padding-top: 0.75rem !important; padding-bottom: 0.75rem !important; }
            [data-viewer-sidebar] .p-2 { padding: 0.5rem !important; }
            [data-viewer-sidebar] .p-1\.5 { padding: 0.375rem !important; }
            [data-viewer-sidebar] .p-1 { padding: 0.25rem !important; }
            [data-viewer-sidebar] .gap-2 { gap: 0.5rem !important; }
            [data-viewer-sidebar] .gap-1 { gap: 0.25rem !important; }
            [data-viewer-sidebar] .pt-3 { padding-top: 0.75rem !important; }
            [data-viewer-sidebar] .pt-4 { padding-top: 1rem !important; }
            [data-viewer-sidebar] .mb-2 { margin-bottom: 0.5rem !important; }
            [data-viewer-sidebar] .mb-3 { margin-bottom: 0.75rem !important; }
            [data-viewer-sidebar] .min-w-0 { min-width: 0 !important; }
            [data-viewer-sidebar] .max-h-32 { max-height: 8rem !important; }
            [data-viewer-sidebar] .overflow-y-auto { overflow-y: auto !important; }
            [data-viewer-sidebar] .overflow-x-hidden { overflow-x: hidden !important; }
            [data-viewer-sidebar] .overflow-hidden { overflow: hidden !important; }
            [data-viewer-sidebar] .rounded { border-radius: 0.25rem !important; }
            [data-viewer-sidebar] .rounded-lg { border-radius: 0.5rem !important; }
            [data-viewer-sidebar] .opacity-70 { opacity: 0.7 !important; }
            [data-viewer-sidebar] .hover\\:opacity-100:hover { opacity: 1 !important; }
            [data-viewer-sidebar] .border-b { border-bottom-width: 1px !important; }
            [data-viewer-sidebar] .border-t { border-top-width: 1px !important; }
            [data-viewer-sidebar] .last\\:border-b-0:last-child { border-bottom-width: 0 !important; }
            [data-viewer-sidebar] .shadow-2xl { box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25) !important; }
            [data-viewer-sidebar] .shadow-lg { box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05) !important; }
            [data-viewer-sidebar] .z-50 { z-index: 50 !important; }
            [data-viewer-sidebar] .z-40 { z-index: 40 !important; }
            [data-viewer-sidebar] .transition-transform { transition-property: transform !important; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1) !important; transition-duration: 300ms !important; }
            [data-viewer-sidebar] .transition-colors { transition-property: color, background-color, border-color !important; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1) !important; transition-duration: 150ms !important; }
            [data-viewer-sidebar] .duration-200 { transition-duration: 200ms !important; }
            [data-viewer-sidebar] .duration-300 { transition-duration: 300ms !important; }
            
            /* Button container animation fix - improve smoothness */
            [data-viewer-sidebar] div[id^="sidebar-buttons-"],
            .potree-viewer-container div[id^="sidebar-buttons-"] {
                transition: transform 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
                will-change: transform !important;
                transform-origin: left center !important;
            }
            
            /* Sidebar animation improvements */
            [data-viewer-sidebar] .sidebar-element {
                transition: transform 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
            }
            [data-viewer-sidebar] .ease-in-out { transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1) !important; }
            [data-viewer-sidebar] .transform { transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y)) !important; }
            [data-viewer-sidebar] .-translate-x-full { --tw-translate-x: -100% !important; }
            [data-viewer-sidebar] .translate-x-0 { --tw-translate-x: 0px !important; }
            [data-viewer-sidebar] .grid { display: grid !important; }
            [data-viewer-sidebar] .grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
            [data-viewer-sidebar] .gap-2 { gap: 0.5rem !important; }
            [data-viewer-sidebar] .text-left { text-align: left !important; }
            [data-viewer-sidebar] .text-sm { font-size: 0.875rem !important; line-height: 1.25rem !important; }
            [data-viewer-sidebar] .text-lg { font-size: 1.125rem !important; line-height: 1.75rem !important; }
            [data-viewer-sidebar] .font-medium { font-weight: 500 !important; }
            [data-viewer-sidebar] .font-semibold { font-weight: 600 !important; }
