                </button>
            </div>
        `;
        
        // Connect navigation buttons to viewer functionality
        this.connectNavigationControls();
    }
    
    /**
     * Connect navigation buttons to viewer camera controls
     */
    connectNavigationControls() {
        const viewerId = this.viewerId;
        
        // Connect directional view buttons
        const frontBtn = document.getElementById(`frontView-${viewerId}`);
        if (frontBtn) {
            frontBtn.addEventListener('click', () => {
                if (this.viewer && this.viewer.setFrontView) {
                    console.log('Setting front view for viewer:', viewerId);
                    this.viewer.setFrontView();
                }
            });
        }
        
        const backBtn = document.getElementById(`backView-${viewerId}`);
        if (backBtn) {
            backBtn.addEventListener('click', () => {
                if (this.viewer && this.viewer.setBackView) {
                    console.log('Setting back view for viewer:', viewerId);
                    this.viewer.setBackView();
                }
            });
        }
        
        const leftBtn = document.getElementById(`leftView-${viewerId}`);
        if (leftBtn) {
            leftBtn.addEventListener('click', () => {
                if (this.viewer && this.viewer.setLeftView) {
                    console.log('Setting left view for viewer:', viewerId);
                    this.viewer.setLeftView();
                }
            });
        }
        
        const rightBtn = document.getElementById(`rightView-${viewerId}`);
        if (rightBtn) {
            rightBtn.addEventListener('click', () => {
                if (this.viewer && this.viewer.setRightView) {
                    console.log('Setting right view for viewer:', viewerId);
                    this.viewer.setRightView();
                }
            });
        }
        
        const topBtn = document.getElementById(`topView-${viewerId}`);
        if (topBtn) {
            topBtn.addEventListener('click', () => {
                if (this.viewer && this.viewer.setTopView) {
                    console.log('Setting top view for viewer:', viewerId);
                    this.viewer.setTopView();
                }
            });
        }
        
        const bottomBtn = document.getElementById(`bottomView-${viewerId}`);
        if (bottomBtn) {
            bottomBtn.addEventListener('click', () => {
                if (this.viewer && this.viewer.setBottomView) {
                    console.log('Setting bottom view for viewer:', viewerId);
                    this.viewer.setBottomView();
                }
            });
        }
        
        const fitBtn = document.getElementById(`fitToScreen-${viewerId}`);
        if (fitBtn) {
            fitBtn.addEventListener('click', () => {
                if (this.viewer && this.viewer.fitToScreen) {
                    console.log('Fitting to screen for viewer:', viewerId);
                    this.viewer.fitToScreen();
                }
            });
        }
    }
    
