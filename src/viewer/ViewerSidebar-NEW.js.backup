                <div class="border-t border-gray-700 pt-3">
                    <label class="flex items-center space-x-3">
                        <input type="checkbox" class="form-checkbox h-4 w-4 text-blue-600 rounded">
                        <span class="text-sm text-gray-300">Show Inside</span>
