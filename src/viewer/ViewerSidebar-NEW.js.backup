            [data-viewer-sidebar] .text-white { color: #FFFFFF !important; }
            [data-viewer-sidebar] .text-gray-300 { color: #D1D5DB !important; }
            [data-viewer-sidebar] .text-gray-400 { color: #9CA3AF !important; }
            [data-viewer-sidebar] .text-blue-600 { color: #2563EB !important; }
            [data-viewer-sidebar] .border-gray-700 { border-color: #374151 !important; }
            
            /* Hover states */
            [data-viewer-sidebar] .hover\\:bg-gray-800:hover { background-color: #1F2937 !important; }
            [data-viewer-sidebar] .hover\\:bg-gray-600:hover { background-color: #4B5563 !important; }
            [data-viewer-sidebar] .hover\\:bg-blue-700:hover { background-color: #1D4ED8 !important; }
            [data-viewer-sidebar] .hover\\:bg-green-700:hover { background-color: #047857 !important; }
