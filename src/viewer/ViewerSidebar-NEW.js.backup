            [data-viewer-sidebar] .hover\\:text-white:hover { color: #FFFFFF !important; }
            
            /* Focus states */
            [data-viewer-sidebar] .focus\\:outline-none:focus { outline: 2px solid transparent !important; outline-offset: 2px !important; }
            [data-viewer-sidebar] .focus\\:ring-2:focus { box-shadow: 0 0 0 2px #3B82F6 !important; }
            [data-viewer-sidebar] .focus\\:ring-blue-500:focus { box-shadow: 0 0 0 2px #3B82F6 !important; }
            
            /* Form elements */
            [data-viewer-sidebar] input[type="range"] {
                width: 100%;
                height: 8px;
                background: #374151;
                border-radius: 4px;
                appearance: none;
                cursor: pointer;
            }
            
            [data-viewer-sidebar] input[type="range"]::-webkit-slider-thumb {
                appearance: none;
                height: 16px;
                width: 16px;
                border-radius: 50%;
                background: #3B82F6;
                cursor: pointer;
                border: none;
            }
            
            [data-viewer-sidebar] input[type="range"]::-moz-range-thumb {
                height: 16px;
                width: 16px;
                border-radius: 50%;
                background: #3B82F6;
                cursor: pointer;
                border: none;
            }
            
            [data-viewer-sidebar] input[type="checkbox"] {
                width: 1rem;
                height: 1rem;
                color: #2563EB;
                border-radius: 0.25rem;
                border: 1px solid #6B7280;
                background-color: #1F2937;
            }
            
            [data-viewer-sidebar] input[type="radio"] {
                width: 1rem;
                height: 1rem;
                color: #2563EB;
                border: 1px solid #6B7280;
                background-color: #1F2937;
            }
            
            /* SVG icon styling - ensure icons are visible */
            [data-viewer-sidebar] svg {
                display: block !important;
                fill: currentColor !important;
                stroke: currentColor !important;
            }
            
            /* Button styling */
            [data-viewer-sidebar] button {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                border: none !important;
                cursor: pointer !important;
            }
            
            /* Custom scrollbar */
            [data-viewer-sidebar] .scrollbar-thin::-webkit-scrollbar {
                width: 6px;
            }
            
            [data-viewer-sidebar] .scrollbar-thin::-webkit-scrollbar-track {
                background: #1F2937;
            }
            
            [data-viewer-sidebar] .scrollbar-thin::-webkit-scrollbar-thumb {
                background: #4B5563;
                border-radius: 3px;
            }
            
            [data-viewer-sidebar] .scrollbar-thin::-webkit-scrollbar-thumb:hover {
                background: #6B7280;
            }
            
            /* Sidebar positioning fixes */
            [data-viewer-sidebar] .viewer-sidebar-container {
                position: absolute !important;
                top: 0 !important;
                left: 0 !important;
                width: 100% !important;
                height: 100% !important;
                pointer-events: none !important;
                z-index: 1000 !important;
            }
            
            [data-viewer-sidebar] .viewer-sidebar-content {
                pointer-events: auto !important;
            }
            
            /* Viewport constraint classes */
            .potree-viewport-container {
                contain: layout style !important;
                isolation: isolate !important;
            }
            
            .potree-viewport-container [data-viewer-sidebar] {
                contain: layout !important;
            }
            
            /* Ensure sidebars are clipped to their viewport */
            .potree-multi-viewer-container .potree-viewer-container {
                overflow: hidden !important;
                contain: strict !important;
            }
        `;
        document.head.appendChild(scopedStyles);
    }
    
    /**
     * Toggle sidebar open/closed
     */
    toggle() {
        if (this.isOpen) {
            this.close();
        } else {
            this.open();
        }
    }
    
    /**
     * Open sidebar
     */
    open() {
        if (this.isOpen) return;
        
        this.isOpen = true;
        
        // Check for viewport spillover and adjust positioning
        this.adjustPositionForViewport();
        
        // Show sidebar and animate it in
        this.sidebarElement.style.display = 'block';
        this.sidebarElement.classList.remove('-translate-x-full');
        
        // Animate icons to the right when sidebar opens
        const sidebarWidth = parseInt(this.config.width);
        this.buttonsContainer.style.transform = `translateX(${sidebarWidth + 16}px)`; // 16px additional spacing
        
        // Update hamburger button
        this.hamburgerButton.innerHTML = `
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        `;
        
        // Populate sections with viewer data
        this.populateWithViewerData();
        
        this.dispatchEvent({
            type: 'sidebar_opened',
            viewerId: this.viewerId,
            sidebar: this
        });
    }
    
    /**
     * Close sidebar
     */
    close() {
        if (!this.isOpen) return;
        
        this.isOpen = false;
        
        // Animate sidebar out and then hide it completely
        this.sidebarElement.classList.add('-translate-x-full');
        
        // After animation completes, hide the sidebar completely to prevent overflow
        setTimeout(() => {
            if (!this.isOpen) { // Double-check it wasn't reopened during animation
                this.sidebarElement.style.display = 'none';
            }
        }, 300); // Match animation duration
        
        // Animate icons back to original position when sidebar closes
        this.buttonsContainer.style.transform = 'translateX(0px)';
        
        // Update hamburger button
        this.hamburgerButton.innerHTML = `
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        `;
        
        this.dispatchEvent({
            type: 'sidebar_closed',
            viewerId: this.viewerId,
            sidebar: this
        });
    }
    
    /**
     * Adjust sidebar position to prevent spillover into other viewports
     */
    adjustPositionForViewport() {
        if (!this.containerElement || !this.sidebarElement) return;
        
        const viewerRect = this.containerElement.getBoundingClientRect();
        const sidebarWidth = parseInt(this.config.width, 10);
        
        // Check if sidebar would spill into other viewports
        const availableWidth = viewerRect.width;
        const availableHeight = viewerRect.height;
        
        // Constrain sidebar to viewer boundaries
        let finalWidth = sidebarWidth;
        let finalHeight = availableHeight * 0.95;
        
        if (sidebarWidth > availableWidth * 0.8) {
            // Reduce sidebar width if viewer is too small
            finalWidth = Math.max(250, availableWidth * 0.7);
        }
        
        // Apply constraints
        this.sidebarElement.style.width = `${finalWidth}px`;
        this.sidebarElement.style.maxHeight = `${finalHeight}px`;
        
        // Ensure content container has proper max height
        const headerHeight = 60; // Approximate header height
        this.contentContainer.style.maxHeight = `${finalHeight - headerHeight}px`;
        
        // Add clip constraint to prevent any spillover beyond viewer bounds
        this.containerElement.style.clipPath = `inset(0 0 0 0)`;
        this.containerElement.style.overflow = 'hidden'; // Override previous setting for strict containment
        
        // Update icon animation offset based on final sidebar width
        if (this.isOpen) {
            this.buttonsContainer.style.transform = `translateX(${finalWidth + 16}px)`;
        }
    }
    
    /**
     * Toggle section expanded/collapsed state
     */
    toggleSection(sectionId) {
        const section = this.sections.get(sectionId);
        if (!section) return;
        
        if (section.isOpen) {
            this.collapseSection(section);
        } else {
            this.expandSection(section);
        }
    }
    
    /**
     * Expand section
     */
    expandSection(section) {
        section.isOpen = true;
        section.content.style.maxHeight = section.content.scrollHeight + 'px';
        section.chevron.style.transform = 'rotate(90deg)';
        this.activeSections.add(section.id);
    }
    
    /**
     * Collapse section
     */
    collapseSection(section) {
        section.isOpen = false;
        section.content.style.maxHeight = '0px';
        section.chevron.style.transform = 'rotate(0deg)';
        this.activeSections.delete(section.id);
    }
    
    /**
     * Populate sections with current viewer data
     */
    populateWithViewerData() {
        // This integrates with actual viewer properties based on real Potree sidebar
        console.log(`Populating sidebar with data for viewer '${this.viewerId}'`);
        
        if (!this.viewer) return;
        
        // The controls are already connected when sections are created
        // No need to recreate HTML, just ensure functionality is working
        console.log('Sidebar controls should be functional for viewer:', this.viewerId);
    }
    
    /**
     * Handle top view quick action
     */
    handleTopView() {
        if (this.viewer && this.viewer.scene && this.viewer.scene.view) {
            // Set camera to top view
            const view = this.viewer.scene.view;
            const scene = this.viewer.scene;
            
            if (scene.pointclouds && scene.pointclouds.length > 0) {
                // Use first point cloud for positioning
                const pointcloud = scene.pointclouds[0];
                const boundingBox = pointcloud.boundingBox;
                
                if (boundingBox) {
                    const center = boundingBox.getCenter(new THREE.Vector3());
                    const size = boundingBox.getSize(new THREE.Vector3());
                    
                    // Position camera above the center
                    view.position.set(center.x, center.y, center.z + size.z * 2);
                    view.lookAt(center.x, center.y, center.z);
                    
                    console.log(`Set top view for viewer '${this.viewerId}'`);
                }
            }
        }
        
        this.quickActions.topView = true;
        this.updateQuickActionStates();
    }
    
    /**
     * Handle lock view quick action
     */
    handleLockView() {
        this.quickActions.lockView = !this.quickActions.lockView;
        
        if (this.quickActions.lockView) {
            // Store current view state and disable controls
            this.quickActions.lastViewState = this.captureViewState();
            this.disableViewerControls();
            
            this.quickActionButtons.lockView.classList.add('bg-red-600', 'hover:bg-red-500');
            this.quickActionButtons.lockView.classList.remove('bg-gray-600', 'hover:bg-gray-500');
        } else {
            // Re-enable controls
            this.enableViewerControls();
            
            this.quickActionButtons.lockView.classList.remove('bg-red-600', 'hover:bg-red-500');
            this.quickActionButtons.lockView.classList.add('bg-gray-600', 'hover:bg-gray-500');
        }
        
        console.log(`View lock ${this.quickActions.lockView ? 'enabled' : 'disabled'} for viewer '${this.viewerId}'`);
        this.updateQuickActionStates();
    }
    
    /**
     * Handle zoom to extents quick action
     */
    handleZoomExtents() {
        if (this.viewer && this.viewer.scene) {
            const scene = this.viewer.scene;
            
            if (scene.pointclouds && scene.pointclouds.length > 0) {
                // Zoom to fit all point clouds
                scene.view.fitToScreen();
                console.log(`Zoomed to extents for viewer '${this.viewerId}'`);
            } else {
                console.warn(`No point clouds to zoom to in viewer '${this.viewerId}'`);
            }
        }
    }
    
    /**
     * Capture current view state
     */
    captureViewState() {
        if (!this.viewer || !this.viewer.scene) return null;
        
        const view = this.viewer.scene.view;
        return {
            position: view.position.clone(),
            rotation: view.rotation ? view.rotation.clone() : null,
            yaw: view.yaw,
            pitch: view.pitch,
            radius: view.radius
        };
    }
    
    /**
     * Disable viewer controls
     */
    disableViewerControls() {
        // This would integrate with actual viewer controls
        // Placeholder for now
        console.log(`Disabled controls for viewer '${this.viewerId}'`);
    }
    
    /**
     * Enable viewer controls
     */
    enableViewerControls() {
        // This would integrate with actual viewer controls
        // Placeholder for now
        console.log(`Enabled controls for viewer '${this.viewerId}'`);
    }
    
    /**
     * Update quick action button states
     */
    updateQuickActionStates() {
        // Update button appearances based on state
        if (this.quickActions.topView) {
            this.quickActionButtons.topView.classList.add('bg-blue-600', 'hover:bg-blue-500');
            this.quickActionButtons.topView.classList.remove('bg-gray-600', 'hover:bg-gray-500');
        }
    }
    
    /**
     * Get sidebar state
     */
    getState() {
        return {
            isOpen: this.isOpen,
            activeSections: Array.from(this.activeSections),
            quickActions: { ...this.quickActions }
        };
    }
    
    /**
     * Restore sidebar state
     */
    setState(state) {
        if (state.isOpen && !this.isOpen) {
            this.open();
        } else if (!state.isOpen && this.isOpen) {
            this.close();
        }
        
        if (state.activeSections) {
            this.activeSections.clear();
            state.activeSections.forEach(sectionId => {
                this.activeSections.add(sectionId);
                const section = this.sections.get(sectionId);
                if (section) {
                    this.expandSection(section);
                }
            });
        }
        
        if (state.quickActions) {
            Object.assign(this.quickActions, state.quickActions);
            this.updateQuickActionStates();
        }
    }
    
    /**
     * Destroy sidebar and cleanup resources
     */
    destroy() {
        // Remove event listeners
        if (this.hamburgerButton) {
            this.hamburgerButton.remove();
        }
        
        if (this.sidebarElement) {
            this.sidebarElement.remove();
        }
        
        // Clear sections
        this.sections.clear();
        this.activeSections.clear();
        
        // Clear references
        this.containerElement = null;
        this.sidebarElement = null;
        this.hamburgerButton = null;
        this.quickActionButtons = null;
        this.contentContainer = null;
        
        this.removeAllListeners();
        
        console.log(`ViewerSidebar destroyed for viewer '${this.viewerId}'`);
    }
}