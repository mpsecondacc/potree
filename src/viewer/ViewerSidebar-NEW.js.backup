            <div class="space-y-3">
                <div class="grid grid-cols-2 gap-2">
                    <button id="frontView-${this.viewerId}" class="bg-gray-700 hover:bg-gray-600 text-white py-2 px-3 rounded transition-colors text-sm">
                        Front
                    </button>
                    <button id="backView-${this.viewerId}" class="bg-gray-700 hover:bg-gray-600 text-white py-2 px-3 rounded transition-colors text-sm">
                        Back
